pipeline {
    agent any

    stages {
        stage('Step 1 - Checkout code') {
            steps {
                checkout scmGit(
                    branches: [[name: '*/applications/outline']],
                    extensions: [submodule(recursiveSubmodules: true)],
                    userRemoteConfigs: scm.userRemoteConfigs
                )
            }
        }

        stage('Step 2 - Generate .env file') {
            steps {
                powershell '''
                    Write-Host "=== Generating .env file ==="
                    $SECRET_KEY = -join ((1..32) | ForEach-Object { "{0:x2}" -f (Get-Random -Minimum 0 -Maximum 256) })
                    $UTILS_SECRET = -join ((1..32) | ForEach-Object { "{0:x2}" -f (Get-Random -Minimum 0 -Maximum 256) })
                    @"
NODE_ENV=development
URL=http://localhost:3000
PORT=3000
WEB_CONCURRENCY=1
DEFAULT_LANGUAGE=en_US
DATABASE_URL=postgres://outline_user:outline_pass@127.0.0.1:5432/outline
PGSSLMODE=disable
REDIS_URL=redis://127.0.0.1:6379
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=C:\\tools\\outline-data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000
FORCE_HTTPS=false
RATE_LIMITER_ENABLED=false
ENABLE_UPDATES=false
DEBUG=http
LOG_LEVEL=debug
SMTP_FROM_EMAIL=hello@example.com
SECRET_KEY=$SECRET_KEY
UTILS_SECRET=$UTILS_SECRET
DEVELOPMENT_UNSAFE_INLINE_CSP=true
"@ | Set-Content -Path outline\\.env -Encoding UTF8
                    Write-Host "[OK] .env file created at outline\\.env"
                '''
            }
        }

        stage('Step 3 - Verify dependencies') {
            steps {
                powershell '''
                    Write-Host "=== Verifying system dependencies ==="
                    node --version
                    yarn --version
                    cmd /c "C:\\tools\\pgsql\\bin\\pg_isready.exe 2>nul && echo PG_OK || echo PG_FAIL"
                    cmd /c "C:\\tools\\redis\\redis-cli.exe ping 2>nul && echo REDIS_OK || echo REDIS_FAIL"
                '''
            }
        }

        stage('Step 4 - Start services') {
            steps {
                powershell '''
                    Write-Host "=== Starting PostgreSQL ==="
                    cmd /c "C:\\tools\\pgsql\\bin\\pg_isready.exe 2>nul"
                    if ($LASTEXITCODE -ne 0) {
                        cmd /c "C:\\tools\\pgsql\\bin\\pg_ctl.exe start -D C:\\tools\\pgsql\\data -l C:\\tools\\pgsql\\log.txt"
                    } else {
                        Write-Host "PostgreSQL is already running"
                    }
                    Write-Host "=== Starting Redis ==="
                    cmd /c "C:\\tools\\redis\\redis-cli.exe ping 2>nul"
                    if ($LASTEXITCODE -ne 0) {
                        Start-Process -FilePath "C:\\tools\\redis\\redis-server.exe" -ArgumentList "C:\\tools\\redis\\redis.windows.conf" -WindowStyle Hidden
                    } else {
                        Write-Host "Redis is already running"
                    }
                    Start-Sleep -Seconds 3
                    Write-Host "=== Verifying services ==="
                    cmd /c "C:\\tools\\pgsql\\bin\\pg_isready.exe"
                    if ($LASTEXITCODE -eq 0) { Write-Host "PostgreSQL: OK" } else { Write-Host "PostgreSQL: FAILED"; exit 1 }
                    cmd /c "C:\\tools\\redis\\redis-cli.exe ping"
                    if ($LASTEXITCODE -eq 0) { Write-Host "Redis: OK" } else { Write-Host "Redis: FAILED"; exit 1 }
                '''
            }
        }

        stage('Step 5 - Install dependencies') {
            steps {
                powershell '''
                    cd outline
                    Write-Host "=== Cleaning previous build ==="
                    yarn clean 2>$null; $true
                    if (Test-Path "node_modules\\.cache") { Remove-Item -Recurse -Force "node_modules\\.cache" }
                    Write-Host "=== Installing dependencies ==="
                    $env:NODE_ENV = "development"
                    yarn install --immutable
                '''
            }
        }

        stage('Step 6 - Build Outline') {
            steps {
                powershell '''
                    cd outline
                    Write-Host "=== Building Outline ==="
                    $env:NODE_ENV = "production"
                    yarn build
                '''
            }
        }

        stage('Step 7 - Reset database') {
            steps {
                powershell '''
                    Write-Host "=== Ensuring services are running ==="
                    cmd /c "C:\\tools\\pgsql\\bin\\pg_isready.exe 2>nul"
                    if ($LASTEXITCODE -ne 0) {
                        cmd /c "C:\\tools\\pgsql\\bin\\pg_ctl.exe start -D C:\\tools\\pgsql\\data -l C:\\tools\\pgsql\\log.txt"
                        Start-Sleep -Seconds 3
                    }
                    cmd /c "C:\\tools\\redis\\redis-cli.exe ping 2>nul"
                    if ($LASTEXITCODE -ne 0) {
                        Start-Process -FilePath "C:\\tools\\redis\\redis-server.exe" -ArgumentList "C:\\tools\\redis\\redis.windows.conf" -WindowStyle Hidden
                        Start-Sleep -Seconds 2
                    }
                    cd outline
                    Write-Host "=== Resetting database ==="
                    cmd /c "C:\\tools\\pgsql\\bin\\dropdb.exe -U postgres --if-exists outline"
                    cmd /c "C:\\tools\\pgsql\\bin\\createdb.exe -U postgres -O outline_user outline"
                    if ($LASTEXITCODE -eq 0) { Write-Host "[OK] Database recreated" } else { Write-Host "[WARN] Database may not have existed" }
                '''
            }
        }

        stage('Step 8 - Run database migrations') {
            steps {
                powershell '''
                    Write-Host "=== Ensuring services are running ==="
                    cmd /c "C:\\tools\\pgsql\\bin\\pg_isready.exe 2>nul"
                    if ($LASTEXITCODE -ne 0) {
                        cmd /c "C:\\tools\\pgsql\\bin\\pg_ctl.exe start -D C:\\tools\\pgsql\\data -l C:\\tools\\pgsql\\log.txt"
                        Start-Sleep -Seconds 3
                    }
                    cmd /c "C:\\tools\\redis\\redis-cli.exe ping 2>nul"
                    if ($LASTEXITCODE -ne 0) {
                        Start-Process -FilePath "C:\\tools\\redis\\redis-server.exe" -ArgumentList "C:\\tools\\redis\\redis.windows.conf" -WindowStyle Hidden
                        Start-Sleep -Seconds 2
                    }
                    cd outline
                    Write-Host "=== Running database migrations ==="
                    $env:NODE_ENV = "development"
                    Start-Process -FilePath "node" -ArgumentList "build\\server\\index.js" -WindowStyle Hidden
                    Write-Host "Waiting for server to start and run migrations..."
                    Start-Sleep -Seconds 15
                    Write-Host "=== Migration log output ==="
                    if (Test-Path "C:\\tools\\outline-migrations.log") { Get-Content "C:\\tools\\outline-migrations.log" -Tail 30 }
                    cmd /c "taskkill /f /im node.exe 2>nul"
                    Write-Host "Migrations complete"
                '''
            }
        }

        stage('Step 9 - Verify build') {
            steps {
                powershell '''
                    cd outline
                    Write-Host "=== Verifying build ==="
                    if (Test-Path "build\\server\\index.js") { Write-Host "[OK] Server build OK" } else { Write-Host "[FAIL] Server build missing"; exit 1 }
                    if (Test-Path "build\\app" -PathType Container) { Write-Host "[OK] Client build OK" } else { Write-Host "[FAIL] Client build missing"; exit 1 }
                    Write-Host "Outline build completed successfully!"
                '''
            }
        }

        stage('Step 10 - Start Outline') {
            steps {
                powershell '''
                    Write-Host "=== Ensuring services are running ==="
                    cmd /c "C:\\tools\\pgsql\\bin\\pg_isready.exe 2>nul"
                    if ($LASTEXITCODE -ne 0) {
                        cmd /c "C:\\tools\\pgsql\\bin\\pg_ctl.exe start -D C:\\tools\\pgsql\\data -l C:\\tools\\pgsql\\log.txt"
                        Start-Sleep -Seconds 3
                    }
                    cmd /c "C:\\tools\\redis\\redis-cli.exe ping 2>nul"
                    if ($LASTEXITCODE -ne 0) {
                        Start-Process -FilePath "C:\\tools\\redis\\redis-server.exe" -ArgumentList "C:\\tools\\redis\\redis.windows.conf" -WindowStyle Hidden
                        Start-Sleep -Seconds 2
                    }
                    cd outline
                    Write-Host "=== Starting Outline ==="
                    $env:NODE_ENV = "development"
                    Start-Process -FilePath "node" -ArgumentList "build\\server\\index.js" -WindowStyle Hidden
                    Write-Host "Waiting for server to be ready..."
                    Start-Sleep -Seconds 10
                    try {
                        $response = Invoke-WebRequest -Uri "http://localhost:3000" -UseBasicParsing -MaximumRedirection 0 -ErrorAction SilentlyContinue
                        if ($response.StatusCode -eq 200 -or $response.StatusCode -eq 302) {
                            Write-Host "[OK] Outline is running at http://localhost:3000"
                        } else {
                            Write-Host "[WARN] Server started but may still be initializing"
                        }
                    } catch {
                        if ($_.Exception.Response.StatusCode.value__ -eq 302) {
                            Write-Host "[OK] Outline is running at http://localhost:3000"
                        } else {
                            Write-Host "[WARN] Server started but may still be initializing"
                        }
                    }
                '''
            }
        }
    }

    post {
        always {
            powershell 'cmd /c "taskkill /f /im node.exe 2>nul"; $true'
        }
    }
}
