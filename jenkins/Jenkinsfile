pipeline {
    agent any

    environment {
        NVM_DIR = '/home/frederico/.nvm'
        COREPACK_ENABLE_STRICT = '0'
        COREPACK_ENABLE_AUTO_PIN = '0'
    }

    stages {
        stage('Build') {
            steps {
                checkout scm
                sh 'git submodule update --init --recursive'

                dir('directus') {
                    sh 'rm -rf node_modules'
                }

                dir('directus') {
                    sh '''
                        . "$NVM_DIR/nvm.sh"
                        nvm use 22
                        echo 'ignored-built-dependencies[]=isolated-vm' >> .npmrc
                        pnpm install --frozen-lockfile
                        sed -i '/^ignored-built-dependencies/d' .npmrc
                    '''
                }

                dir('directus') {
                    sh '''
                        . "$NVM_DIR/nvm.sh"
                        nvm use 22
                        pnpm lint
                    '''
                }

                dir('directus') {
                    sh '''
                        . "$NVM_DIR/nvm.sh"
                        nvm use 22
                        pnpm build
                    '''
                }
            }
        }
    }
}

