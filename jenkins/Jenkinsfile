                powershell 'echo "Step 3 - waiting..."; Start-Sleep -Seconds 3'
                powershell 'echo "Step 4 - waiting..."; Start-Sleep -Seconds 3'
                powershell 'echo "Step 5 - waiting..."; Start-Sleep -Seconds 3'
                powershell 'echo "Step 6 - waiting..."; Start-Sleep -Seconds 3'
                powershell 'echo "Step 7 - waiting..."; Start-Sleep -Seconds 3'
                powershell 'echo "Step 8 - waiting..."; Start-Sleep -Seconds 3'
                powershell 'echo "Step 9 - waiting..."; Start-Sleep -Seconds 3'
                powershell 'echo "Step 10 - done!"; Start-Sleep -Seconds 3'
            }
        }
    }
