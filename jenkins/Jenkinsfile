pipeline {
    agent any

    tools {
        nodejs 'Node22'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                dir('directus') {
                    sh 'corepack enable'
                    sh 'corepack prepare pnpm@10 --activate'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('directus') {
                    sh 'pnpm install --frozen-lockfile'
                }
            }
        }

        stage('Lint') {
            steps {
                dir('directus') {
                    sh 'pnpm lint'
                }
            }
        }

        stage('Build') {
            steps {
                dir('directus') {
                    sh 'pnpm build'
                }
            }
        }

        stage('Test') {
            steps {
                dir('directus') {
                    sh "pnpm --recursive --filter '!tests-blackbox' --filter '!tests-e2e' --filter '!e2e' --filter '!app' test"
                }
            }
        }
    }
}
