pipeline {
    agent any

    environment {
        NODE_HOME = 'C:\\Program Files\\nodejs'
        NPM_GLOBAL = 'C:\\ProgramData\\npm'
    }

    stages {
        
        stage('Build and Test') {
            steps {
                checkout scm
                bat 'git submodule update --init --recursive'
                dir('directus') {
                    bat 'npm install -g pnpm@10 --force'
                    bat 'npm list -g pnpm'
                    bat 'pnpm install --frozen-lockfile'
                    bat 'pnpm lint'
                    bat 'pnpm build'
                }
            }
        }
    }
}


