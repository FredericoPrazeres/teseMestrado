pipeline {
    agent any

    environment {
        NODE_ENV_BUILD = 'production'
        PGSQL_BIN = 'D:\\tools\\pgsql\\bin'
        PGSQL_DATA = 'D:\\tools\\pgsql\\data'
        REDIS_DIR = 'D:\\tools\\redis'
    }

    stages {
        stage('Build Outline') {
            steps {
                // Step 1: Checkout
                checkout scm
                bat 'git submodule update --init --recursive'

                // Step 2: Generate .env
                dir('outline') {
                    powershell '''
                        Write-Host "=== Generating .env file ==="
                        $SECRET_KEY = -join ((1..32) | ForEach-Object { "{0:x2}" -f (Get-Random -Minimum 0 -Maximum 256) })
                        $UTILS_SECRET = -join ((1..32) | ForEach-Object { "{0:x2}" -f (Get-Random -Minimum 0 -Maximum 256) })
                        @"
NODE_ENV=development
URL=http://localhost:3000
PORT=3000
WEB_CONCURRENCY=1
DEFAULT_LANGUAGE=en_US
DATABASE_URL=postgres://outline_user:outline_pass@127.0.0.1:5432/outline
PGSSLMODE=disable
REDIS_URL=redis://127.0.0.1:6379
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=D:\\tools\\outline-data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000
FORCE_HTTPS=false
RATE_LIMITER_ENABLED=false
ENABLE_UPDATES=false
DEBUG=http
LOG_LEVEL=debug
SMTP_FROM_EMAIL=hello@example.com
SECRET_KEY=$SECRET_KEY
UTILS_SECRET=$UTILS_SECRET
DEVELOPMENT_UNSAFE_INLINE_CSP=true
"@ | Set-Content -Path .env -Encoding UTF8
                        Write-Host "✅ .env file created"
                    '''
                }

                // Step 3: Verify dependencies
                dir('outline') {
                    powershell '''
                        Write-Host "=== Verifying system dependencies ==="
                        Write-Host "Node.js: $(node --version)"
                        Write-Host "Yarn: $(yarn --version)"
                        cmd /c "D:\\tools\\pgsql\\bin\\pg_isready.exe 2>nul && echo PG_OK || echo PG_FAIL"
                        cmd /c "D:\\tools\\redis\\redis-cli.exe ping 2>nul && echo REDIS_OK || echo REDIS_FAIL"
                    '''
                }

                // Step 4: Start services
                powershell '''
                    Write-Host "=== Starting PostgreSQL ==="
                    cmd /c "D:\\tools\\pgsql\\bin\\pg_isready.exe 2>nul"
                    if ($LASTEXITCODE -ne 0) {
                        cmd /c "D:\\tools\\pgsql\\bin\\pg_ctl.exe start -D D:\\tools\\pgsql\\data -l D:\\tools\\pgsql\\log.txt"
                    } else {
                        Write-Host "PostgreSQL is already running"
                    }
                    Write-Host "=== Starting Redis ==="
                    cmd /c "D:\\tools\\redis\\redis-cli.exe ping 2>nul"
                    if ($LASTEXITCODE -ne 0) {
                        Start-Process -FilePath "D:\\tools\\redis\\redis-server.exe" -ArgumentList "D:\\tools\\redis\\redis.windows.conf" -WindowStyle Hidden
                    } else {
                        Write-Host "Redis is already running"
                    }
                    Start-Sleep -Seconds 3
                    Write-Host "=== Verifying services ==="
                    cmd /c "D:\\tools\\pgsql\\bin\\pg_isready.exe"
                    if ($LASTEXITCODE -eq 0) { Write-Host "PostgreSQL: OK" } else { Write-Host "PostgreSQL: FAILED"; exit 1 }
                    cmd /c "D:\\tools\\redis\\redis-cli.exe ping"
                    if ($LASTEXITCODE -eq 0) { Write-Host "Redis: OK" } else { Write-Host "Redis: FAILED"; exit 1 }
                '''

                // Step 5: Install dependencies
                dir('outline') {
                    bat '''
                        echo === Cleaning previous build ===
                        call yarn clean 2>nul
                        if exist "node_modules\\.cache" rmdir /s /q "node_modules\\.cache"
                        echo === Installing Node.js dependencies ===
                        set NODE_ENV=development
                        call yarn install --immutable
                    '''
                }

                // Step 6: Build
                dir('outline') {
                    bat '''
                        echo === Building Outline ===
                        set NODE_ENV=production
                        call yarn build
                    '''
                }

                // Step 7: Reset database
                dir('outline') {
                    bat '''
                        echo === Resetting database ===
                        D:\\tools\\pgsql\\bin\\dropdb.exe -U postgres --if-exists outline
                        D:\\tools\\pgsql\\bin\\createdb.exe -U postgres -O outline_user outline
                        if %ERRORLEVEL% EQU 0 (echo Database recreated) else (echo Database may not have existed)
                    '''
                }

                // Step 8: Database migrations
                dir('outline') {
                    bat '''
                        echo === Running database migrations ===
                        call yarn db:create --env=production-ssl-disabled 2>nul
                        echo Database create step done (may already exist)
                        set NODE_ENV=development
                        start /b node build\\server\\index.js > D:\\tools\\outline-migrations.log 2>&1
                        echo Waiting for server to start and run migrations...
                        timeout /t 15 /nobreak > nul
                        echo === Migration log output ===
                        if exist "D:\\tools\\outline-migrations.log" type "D:\\tools\\outline-migrations.log"
                        taskkill /f /im node.exe 2>nul
                        echo Migrations complete
                    '''
                }

                // Step 9: Verify build
                dir('outline') {
                    powershell '''
                        Write-Host "=== Verifying build ==="
                        if (Test-Path "build\\server\\index.js") { Write-Host "✅ Server build OK" } else { Write-Host "❌ Server build missing"; exit 1 }
                        if (Test-Path "build\\app" -PathType Container) { Write-Host "✅ Client build OK" } else { Write-Host "❌ Client build missing"; exit 1 }
                        Write-Host "🎉 Outline build completed successfully!"
                    '''
                }

                // Step 10: Start Outline
                dir('outline') {
                    bat '''
                        echo === Starting Outline ===
                        set NODE_ENV=development
                        start /b node build\\server\\index.js > D:\\tools\\outline-server.log 2>&1
                        echo Waiting for server to be ready...
                        timeout /t 10 /nobreak > nul
                    '''
                    powershell '''
                        try {
                            $response = Invoke-WebRequest -Uri "http://localhost:3000" -UseBasicParsing -MaximumRedirection 0 -ErrorAction SilentlyContinue
                            if ($response.StatusCode -eq 200 -or $response.StatusCode -eq 302) {
                                Write-Host "✅ Outline is running at http://localhost:3000"
                            } else {
                                Write-Host "⚠️ Server started but may still be initializing"
                            }
                        } catch {
                            if ($_.Exception.Response.StatusCode.value__ -eq 302) {
                                Write-Host "✅ Outline is running at http://localhost:3000"
                            } else {
                                Write-Host "⚠️ Server started but may still be initializing"
                            }
                        }
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '✅ Outline pipeline completed successfully!'
        }
        failure {
            echo '❌ Outline pipeline failed.'
        }
    }
}
