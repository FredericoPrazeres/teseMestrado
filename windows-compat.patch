@@ -188,7 +191,29 @@ class HassEventLoopPolicy(asyncio.DefaultEventLoopPolicy):  # type: ignore[name-
 
     def new_event_loop(self) -> asyncio.AbstractEventLoop:
         """Get the event loop."""
-        loop: asyncio.AbstractEventLoop = super().new_event_loop()
+        if sys.platform == "win32":
+            import socket as _socket
+
+            # On Windows, ProactorEventLoop.__init__ calls socket.socketpair()
+            # to create an internal self-pipe. If pytest-socket has patched
+            # socket.socket with its GuardedSocket(s), this raises an error.
+            # Temporarily restore the real socket class (unwrapping all nested
+            # GuardedSocket layers) for loop construction, then restore the patch.
+            _saved_socket = _socket.socket
+            _real_socket = _saved_socket
+            while getattr(_real_socket, "__name__", "") == "GuardedSocket":
+                bases = getattr(_real_socket, "__bases__", ())
+                if not bases:
+                    break
+                _real_socket = bases[0]
+            if _real_socket is not _saved_socket:
+                _socket.socket = _real_socket
+            try:
+                loop: asyncio.AbstractEventLoop = super().new_event_loop()
+            finally:
+                _socket.socket = _saved_socket
+        else:
+            loop = super().new_event_loop()
         loop.set_exception_handler(_async_loop_exception_handler)
