pipeline {
	agent any
	environment {
		NODE_VERSION = '22.15.1'
		TOOLJET_DIR = 'ToolJet'
		NVM_DIR = '/home/fredericoprazeres/.nvm'
	}

	stages {
		// Job 1: Checkout & Environment Info
		stage('Checkout & Environment Info') {
			steps {
				checkout scm
				sh '''
				  git submodule update --init --depth=1 ToolJet
				'''
			}
		}

		// Job 2: Cleanup previous deployment
		stage('Cleanup') {
			steps {
				sh '''
				  docker stop tooljet 2>/dev/null || true
				  docker rm tooljet 2>/dev/null || true
				  docker image prune -f
				  docker volume prune -f
				  docker network prune -f
				'''
			}
		}

		// Job 3: Install dependencies
		stage('Install Dependencies') {
			steps {
				sh '''#!/usr/bin/env bash
				  set -euo pipefail
				  cd "$TOOLJET_DIR"
				  [ -r "$NVM_DIR/nvm.sh" ] || { echo "nvm.sh not readable at $NVM_DIR/nvm.sh"; exit 1; }
				  . "$NVM_DIR/nvm.sh"
				  nvm install "$NODE_VERSION"
				  nvm use "$NODE_VERSION"
				  node -v
				  npm -v
				  npm --prefix plugins install
				  npm --prefix server install --production=false
				  npm --prefix frontend install --production=false
				'''
			}
		}

		// Job 4: Lint & Code Quality
		stage('Lint') {
			steps {
				sh '''#!/usr/bin/env bash
				  set -euo pipefail
				  cd "$TOOLJET_DIR"
				  [ -r "$NVM_DIR/nvm.sh" ] || { echo "nvm.sh not readable at $NVM_DIR/nvm.sh"; exit 1; }
				  . "$NVM_DIR/nvm.sh"
				  nvm install "$NODE_VERSION"
				  nvm use "$NODE_VERSION"
				  node -v
				  npm -v
				  npm --prefix server run lint -- --max-warnings=0 || echo "Server lint completed with warnings"
				  npm --prefix frontend run lint -- --max-warnings=0 || echo "Frontend lint completed with warnings"
				'''
			}
		}

		// Job 5: Build application
		stage('Build') {
			steps {
				sh '''#!/usr/bin/env bash
				  set -euo pipefail
				  cd "$TOOLJET_DIR"
				  [ -r "$NVM_DIR/nvm.sh" ] || { echo "nvm.sh not readable at $NVM_DIR/nvm.sh"; exit 1; }
				  . "$NVM_DIR/nvm.sh"
				  nvm install "$NODE_VERSION"
				  nvm use "$NODE_VERSION"
				  node -v
				  npm -v
				  export NODE_OPTIONS="--max-old-space-size=8192"
				  NODE_ENV=production npm --prefix plugins run build
				  NODE_ENV=production npm --prefix frontend run build
				  npm --prefix server run build
				'''
			}
		}

		// Job 6: Run tests
		stage('Test') {
			steps {
				sh '''#!/usr/bin/env bash
				  set -euo pipefail
				  cd "$TOOLJET_DIR/server"
				  [ -r "$NVM_DIR/nvm.sh" ] || { echo "nvm.sh not readable at $NVM_DIR/nvm.sh"; exit 1; }
				  . "$NVM_DIR/nvm.sh"
				  nvm install "$NODE_VERSION"
				  nvm use "$NODE_VERSION"
				  node -v
				  npm -v
				  NODE_ENV=test npx jest --config jest.config.ts --detectOpenHandles --forceExit --passWithNoTests --testPathIgnorePatterns='test/controllers|test/services|test/modules' || echo "Server tests completed with failures"
				  cd ../frontend
				  npm install --save-dev jest-environment-jsdom || true
				  npx jest --passWithNoTests --forceExit || echo "Frontend tests completed with failures"
				'''
			}
		}
	}
}



