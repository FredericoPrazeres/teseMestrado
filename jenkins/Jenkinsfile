pipeline {
    agent any

    environment {
        NODE_HOME = '/Users/fredericoprazeres/.nvm/versions/node/v22.22.3'
        PATH = "${NODE_HOME}/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                dir('directus') {
                    sh 'node --version'
                    sh 'npm install -g pnpm@10'
                    sh 'pnpm --version'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('directus') {
                    sh 'pnpm install --frozen-lockfile'
                }
            }
        }

        stage('Lint') {
            steps {
                dir('directus') {
                    sh 'pnpm lint'
                }
            }
        }

        stage('Build') {
            steps {
                dir('directus') {
                    sh 'pnpm build'
                }
            }
        }

        stage('Test') {
            steps {
                dir('directus') {
                    sh "pnpm --recursive --filter '!tests-blackbox' --filter '!tests-e2e' --filter '!e2e' --filter '!app' test"
                }
            }
        }
    }
}

