pipeline {
    agent any

    environment {
        NODE_HOME = 'C:\\Program Files\\nodejs'
        PATH = "${NODE_HOME};${env.PATH}"
        COREPACK_ENABLE_STRICT = '0'
        COREPACK_ENABLE_AUTO_PIN = '0'
    }

    stages {
        stage('Build and Test') {
            steps {
                checkout scm
                bat 'git submodule update --init --recursive'
                dir('directus') {
                    bat 'node --version'
                    bat 'npm install -g pnpm@10 --force'
                    bat 'pnpm install --frozen-lockfile'
                    bat 'pnpm lint'
                    bat 'pnpm build'
                    bat 'pnpm --recursive --filter "!tests-blackbox" --filter "!tests-e2e" --filter "!e2e" --filter "!app" test'
                }
            }
        }
    }
}

