pipeline {
    agent any

    environment {
        DATABASE_URL = 'postgresql://postgres@localhost:5450/cal-saml'
        DATABASE_DIRECT_URL = 'postgresql://postgres@localhost:5450/cal-saml'
        PATH = "/usr/local/bin:/opt/homebrew/bin:${env.PATH}"
    }

    stages {
        stage('Job 01 — Cleanup Previous Runs') {
            steps {
                sh '''
                    docker stop $(docker ps -q) 2>/dev/null || true
                    docker rm $(docker ps -aq) 2>/dev/null || true
                    docker rmi $(docker images -q) 2>/dev/null || true
                    docker system prune -af --volumes 2>/dev/null || true
                '''
            }
        }

        stage('Job 02 — Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Job 03 — Node Setup') {
            steps {
                sh '''
                    node --version
                    npm --version
                '''
            }
        }

        stage('Job 04 — Corepack Enable') {
            steps {
                dir('cal.diy') {
                    sh 'corepack enable && corepack install'
                }
            }
        }

        stage('Job 05 — Yarn Install') {
            steps {
                dir('cal.diy') {
                    sh 'yarn install'
                }
            }
        }

        stage('Job 06 — Environment Setup') {
            steps {
                dir('cal.diy') {
                    sh '''
                        cp .env.example .env
                        NEXTAUTH_SECRET=$(openssl rand -base64 32)
                        CALENDSO_ENCRYPTION_KEY=$(openssl rand -base64 24)
                        sed -i '' "s|NEXTAUTH_SECRET=.*|NEXTAUTH_SECRET=$NEXTAUTH_SECRET|" .env
                        sed -i '' "s|CALENDSO_ENCRYPTION_KEY=.*|CALENDSO_ENCRYPTION_KEY=$CALENDSO_ENCRYPTION_KEY|" .env
                        echo "DATABASE_URL=${DATABASE_URL}" >> .env
                        echo "DATABASE_DIRECT_URL=${DATABASE_DIRECT_URL}" >> .env
                    '''
                }
            }
        }

        stage('Job 07 — Lint') {
            steps {
                dir('cal.diy') {
                    sh 'yarn lint'
                }
            }
        }

        stage('Job 08 — Type Check') {
            steps {
                dir('cal.diy') {
                    sh 'yarn type-check'
                }
            }
        }

        stage('Job 09 — Unit Tests') {
            steps {
                dir('cal.diy') {
                    sh "CI=true TZ=UTC yarn test --dangerouslyIgnoreUnhandledErrors --exclude 'packages/lib/OgImages.test.ts' --exclude 'apps/web/app/api/social/og/image/__tests__/route.test.ts'"
                }
            }
        }

        stage('Job 10 — Prisma Validate') {
            steps {
                dir('cal.diy') {
                    sh 'yarn workspace @calcom/prisma prisma validate'
                }
            }
        }

        stage('Job 11 — Start Database') {
            steps {
                dir('cal.diy') {
                    sh 'docker compose -f packages/prisma/docker-compose.yml up -d && sleep 5'
                }
            }
        }

        stage('Job 12 — Build') {
            steps {
                dir('cal.diy') {
                    sh 'yarn build'
                }
            }
        }

        stage('Job 13 — Stop Database') {
            steps {
                dir('cal.diy') {
                    sh 'docker compose -f packages/prisma/docker-compose.yml down || true'
                }
            }
        }

        stage('Job 14 — Docker Build') {
            steps {
                dir('cal.diy') {
                    sh 'docker build -t cal-diy:bench -f Dockerfile . && docker rmi cal-diy:bench || true'
                }
            }
        }
    }

    post {
        always {
            dir('cal.diy') {
                sh 'docker compose -f packages/prisma/docker-compose.yml down || true'
            }
        }
    }
}
