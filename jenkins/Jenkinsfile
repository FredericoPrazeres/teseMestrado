pipeline {
    agent any

    environment {
        PATH = 'C:\\Program Files\\Git\\cmd;C:\\nvm4w\\nodejs;C:\\ProgramData\\npm;${PATH}'
    }

    stages {
        
        stage('checkout') {
            steps{
                checkout scm                
                bat 'git submodule update --init --recursive'

            }

        }
        stage('Npm install') {
            bat 'npm install -g pnpm@10 --force'

        }
        
        stage('Npm list') {
            bat 'npm list -g pnpm'

        }
        stage('Install pnpm') {
            bat 'pnpm install --frozen-lockfile'

        }
        stage('Lint') {
            bat 'pnpm lint'

        }stage('Build') {
            bat 'pnpm build'

        }
    }
}



