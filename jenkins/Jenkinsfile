pipeline {
    agent any

    environment {
        // Use system Node.js installation via PATH
        COREPACK_ENABLE_STRICT = '0'
        COREPACK_ENABLE_AUTO_PIN = '0'
    }

    stages {
        stage('Build and Test') {
            steps {
                checkout scm
                bat 'git submodule update --init --recursive'
                dir('directus') {
                    bat 'node -v && npm -v'
                    bat 'npm install -g pnpm@10 --force'
                    bat 'set "PATH=%APPDATA%\\npm;%PATH%" && pnpm install --frozen-lockfile'
                    bat 'set "PATH=%APPDATA%\\npm;%PATH%" && pnpm lint'
                    bat 'set "PATH=%APPDATA%\\npm;%PATH%" && pnpm build'
                }
            }
        }
    }
}

