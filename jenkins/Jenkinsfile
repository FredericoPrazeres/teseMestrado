pipeline {
    agent any

    environment {
        // Point this to a Node 22 installation on the Jenkins host.
        NODE_HOME = 'C:\\tools\\node-v22.22.3-win-x64'
        PATH = "${NODE_HOME};${env.PATH}"
        COREPACK_ENABLE_STRICT = '0'
        COREPACK_ENABLE_AUTO_PIN = '0'
    }

    stages {
        stage('Build and Test') {
            steps {
                checkout scm
                powershell 'git submodule update --init --recursive'
                dir('directus') {
                    powershell '''
                        $ErrorActionPreference = "Stop"

                        $nodeExe = Join-Path $env:NODE_HOME "node.exe"
                        $npmCmd = Join-Path $env:NODE_HOME "npm.cmd"
                        $pnpmCmd = Join-Path $env:APPDATA "npm\\pnpm.cmd"

                        if (!(Test-Path $nodeExe)) { throw "Node executable not found at $nodeExe" }
                        if (!(Test-Path $npmCmd)) { throw "npm.cmd not found at $npmCmd" }

                        $nodeVersion = & $nodeExe -p "process.version"
                        if (-not $nodeVersion.StartsWith("v22.")) {
                            throw "Node 22 is required. Current: $nodeVersion"
                        }

                        & $nodeExe -v
                        & $npmCmd -v

                        & $npmCmd install -g pnpm@10 --force

                        if (!(Test-Path $pnpmCmd)) { throw "pnpm.cmd not found at $pnpmCmd" }

                        & $pnpmCmd --version
                        & $pnpmCmd install --frozen-lockfile
                        & $pnpmCmd lint
                        & $pnpmCmd build
                    '''
                }
            }
        }
    }
}

