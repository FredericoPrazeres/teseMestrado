pipeline {
    agent any

    environment {
        NODE_ENV_BUILD = 'production'
        PGSQL_BIN = 'D:\\tools\\pgsql\\bin'
        PGSQL_DATA = 'D:\\tools\\pgsql\\data'
        REDIS_DIR = 'D:\\tools\\redis'
    }

    stages {
        // Step 1: Checkout
        stage('Step 1 - Checkout code') {
            steps {
                checkout scm
                bat 'git submodule update --init --recursive'
            }
        }

        // Step 2: Generate .env
        stage('Step 2 - Generate .env file') {
            steps {
                dir('outline') {
                    bat '''
                        echo === Generating .env file ===
                        (
                            echo NODE_ENV=development
                            echo URL=http://localhost:3000
                            echo PORT=3000
                            echo WEB_CONCURRENCY=1
                            echo DEFAULT_LANGUAGE=en_US
                            echo DATABASE_URL=postgres://outline_user:outline_pass@127.0.0.1:5432/outline
                            echo PGSSLMODE=disable
                            echo REDIS_URL=redis://127.0.0.1:6379
                            echo FILE_STORAGE=local
                            echo FILE_STORAGE_LOCAL_ROOT_DIR=D:\\tools\\outline-data
                            echo FILE_STORAGE_UPLOAD_MAX_SIZE=262144000
                            echo FORCE_HTTPS=false
                            echo RATE_LIMITER_ENABLED=false
                            echo ENABLE_UPDATES=false
                            echo DEBUG=http
                            echo LOG_LEVEL=debug
                            echo SMTP_FROM_EMAIL=hello@example.com
                            echo SECRET_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
                            echo UTILS_SECRET=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
                            echo DEVELOPMENT_UNSAFE_INLINE_CSP=true
                        ) > .env
                        echo .env file created
                    '''
                }
            }
        }

        // Step 3: Verify dependencies
        stage('Step 3 - Verify dependencies') {
            steps {
                dir('outline') {
                    bat '''
                        echo === Verifying system dependencies ===
                        node --version
                        call yarn --version
                        D:\\tools\\pgsql\\bin\\pg_isready.exe 2>nul && echo PG_OK || echo PG_FAIL
                        D:\\tools\\redis\\redis-cli.exe ping 2>nul && echo REDIS_OK || echo REDIS_FAIL
                    '''
                }
            }
        }

        // Step 4: Start services
        stage('Step 4 - Start services') {
            steps {
                bat '''
                    echo === Starting PostgreSQL ===
                    D:\\tools\\pgsql\\bin\\pg_isready.exe 2>nul
                    if %ERRORLEVEL% NEQ 0 (
                        D:\\tools\\pgsql\\bin\\pg_ctl.exe start -D D:\\tools\\pgsql\\data -l D:\\tools\\pgsql\\log.txt
                    ) else (
                        echo PostgreSQL is already running
                    )
                    echo === Starting Redis ===
                    D:\\tools\\redis\\redis-cli.exe ping 2>nul
                    if %ERRORLEVEL% NEQ 0 (
                        start "" /b D:\\tools\\redis\\redis-server.exe D:\\tools\\redis\\redis.windows.conf
                    ) else (
                        echo Redis is already running
                    )
                    ping -n 4 127.0.0.1 > nul
                    echo === Verifying services ===
                    D:\\tools\\pgsql\\bin\\pg_isready.exe
                    if %ERRORLEVEL% NEQ 0 (echo PostgreSQL: FAILED && exit /b 1) else (echo PostgreSQL: OK)
                    D:\\tools\\redis\\redis-cli.exe ping
                    if %ERRORLEVEL% NEQ 0 (echo Redis: FAILED && exit /b 1) else (echo Redis: OK)
                '''
            }
        }

        // Step 5: Install dependencies
        stage('Step 5 - Install dependencies') {
            steps {
                dir('outline') {
                    bat '''
                        echo === Cleaning previous build ===
                        call yarn clean 2>nul
                        if exist "node_modules\\.cache" rmdir /s /q "node_modules\\.cache"
                        echo === Installing Node.js dependencies ===
                        set NODE_ENV=development
                        call yarn install --immutable
                    '''
                }
            }
        }

        // Step 6: Build
        stage('Step 6 - Build Outline') {
            steps {
                dir('outline') {
                    bat '''
                        echo === Building Outline ===
                        set NODE_ENV=production
                        call yarn build
                    '''
                }
            }
        }

        // Step 7: Reset database
        stage('Step 7 - Reset database') {
            steps {
                dir('outline') {
                    bat '''
                        echo === Resetting database ===
                        D:\\tools\\pgsql\\bin\\dropdb.exe -U postgres --if-exists outline
                        D:\\tools\\pgsql\\bin\\createdb.exe -U postgres -O outline_user outline
                        if %ERRORLEVEL% EQU 0 (echo Database recreated) else (echo Database may not have existed)
                    '''
                }
            }
        }

        // Step 8: Database migrations
        stage('Step 8 - Run database migrations') {
            steps {
                dir('outline') {
                    bat '''
                        echo === Running database migrations ===
                        call yarn db:create --env=production-ssl-disabled 2>nul
                        echo Database create step done (may already exist)
                        set NODE_ENV=development
                        start "" /b node build\\server\\index.js > D:\\tools\\outline-migrations.log 2>&1
                        echo Waiting for server to start and run migrations...
                        ping -n 16 127.0.0.1 > nul
                        echo === Migration log output ===
                        if exist "D:\\tools\\outline-migrations.log" type "D:\\tools\\outline-migrations.log"
                        taskkill /f /im node.exe 2>nul
                        echo Migrations complete
                    '''
                }
            }
        }

        // Step 9: Verify build
        stage('Step 9 - Verify build') {
            steps {
                dir('outline') {
                    bat '''
                        echo === Verifying build ===
                        if exist "build\\server\\index.js" (echo Server build OK) else (echo Server build missing && exit /b 1)
                        if exist "build\\app" (echo Client build OK) else (echo Client build missing && exit /b 1)
                        echo Outline build completed successfully!
                    '''
                }
            }
        }

        // Step 10: Start Outline
        stage('Step 10 - Start Outline') {
            steps {
                dir('outline') {
                    bat '''
                        echo === Starting Outline ===
                        set NODE_ENV=development
                        start "" /b node build\\server\\index.js > D:\\tools\\outline-server.log 2>&1
                        echo Waiting for server to be ready...
                        ping -n 11 127.0.0.1 > nul
                    '''
                    powershell '''
                        try {
                            $response = Invoke-WebRequest -Uri "http://localhost:3000" -UseBasicParsing -MaximumRedirection 0 -ErrorAction SilentlyContinue
                            if ($response.StatusCode -eq 200 -or $response.StatusCode -eq 302) {
                                Write-Host "Outline is running at http://localhost:3000"
                            } else {
                                Write-Host "Server started but may still be initializing"
                            }
                        } catch {
                            if ($_.Exception.Response.StatusCode.value__ -eq 302) {
                                Write-Host "Outline is running at http://localhost:3000"
                            } else {
                                Write-Host "Server started but may still be initializing"
                            }
                        }
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Outline pipeline completed successfully!'
        }
        failure {
            echo 'Outline pipeline failed.'
        }
    }
}
