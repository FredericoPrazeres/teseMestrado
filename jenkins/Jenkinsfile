// Cal.diy — Job Overhead Benchmark (Jenkins port of .github/workflows/jobs-benchmark.yml)
//
// Each "stage" mirrors one GitHub Actions job. They run sequentially on the same
// Windows self-hosted agent, so the workspace persists between stages.
// Most stages use `dir('cal.diy')` to match the workflow-level
// `defaults.run.working-directory: cal.diy`.

pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    environment {
        DATABASE_URL        = 'postgresql://postgres@localhost:5450/cal-saml'
        DATABASE_DIRECT_URL = 'postgresql://postgres@localhost:5450/cal-saml'
    }

    stages {

        stage('Step 01 — Cleanup Previous Runs') {
            steps {
                powershell '''
                    $ErrorActionPreference = 'Continue'
                    $ids = docker ps -q
                    if ($ids) { docker stop $ids | Out-Null }
                    $ids = docker ps -aq
                    if ($ids) { docker rm $ids | Out-Null }
                    $ids = docker images -q
                    if ($ids) { docker rmi -f $ids | Out-Null }
                    docker system prune -af --volumes | Out-Null
                    $global:LASTEXITCODE = 0
                '''
            }
        }
        

        stage('Step 02 — Checkout') {
            steps {
                // Parent repo only — submodules handled manually below to
                // recover from stale .git/modules caches and ensure the
                // pinned gitlink SHAs are actually fetched.
                checkout scmGit(
                    branches: scm.branches,
                    extensions: [
                        cleanBeforeCheckout(),
                        submodule(disableSubmodules: true)
                    ],
                    userRemoteConfigs: scm.userRemoteConfigs
                )
                
                powershell '''
                    $ErrorActionPreference = 'Stop'

                    # Discover submodule paths from .gitmodules
                    $paths = @()
                    if (Test-Path .gitmodules) {
                        $paths = (git config -f .gitmodules --get-regexp '^submodule\\..*\\.path$') `
                            | ForEach-Object { ($_ -split ' ', 2)[1] }
                    }

                    # Wipe each submodule worktree (the .git pointer files
                    # otherwise point at the cached gitdir we are about to delete).
                    foreach ($p in $paths) {
                        if (Test-Path $p) {
                            Remove-Item -Recurse -Force $p
                            New-Item -ItemType Directory -Path $p | Out-Null
                        }
                    }

                    # Wipe any stale cached gitdirs from earlier runs
                    if (Test-Path .git\\modules) {
                        Remove-Item -Recurse -Force .git\\modules
                    }

                    git submodule sync
                    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
                    git submodule update --init --recursive --force
                    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
                '''
            }
        }



        stage('Step 02b — Patch cal.diy ui build-icons script') {
            steps {
                dir('cal.diy') {
                    powershell '''
                        $f = 'packages/ui/scripts/build-icons.mjs'
                        if (-not (Test-Path $f)) { Write-Error "missing $f"; exit 1 }
                        $c = Get-Content $f -Raw
                        if ($c.Contains('--no-errors-on-unmatched')) {
                            Write-Host "$f already patched"
                        } else {
                            $old = 'format --write ${filepath}'
                            $new = 'format --write --no-errors-on-unmatched ${filepath}'
                            if (-not $c.Contains($old)) { Write-Error "patch anchor not found in $f"; exit 1 }
                            $c = $c.Replace($old, $new)
                            Set-Content -Path $f -Value $c -NoNewline -Encoding UTF8
                            Write-Host "Patched $f"
                        }
                    '''
                }
            }
        }

        stage('Step 03 — Node Setup') {
            steps {
                // Use the Node already installed on the agent's PATH (matches
                // how the other runners build cal.diy). Requires Node ≥ 22.12
                // so the embed-react vite config can require() ESM plugins.
                powershell 'node --version; npm --version'
            }
        }


        stage('Step 04 — Corepack Enable') {
            steps {
                dir('cal.diy') {
                    powershell '''
                        corepack enable
                        if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
                        corepack install
                    '''
                }
            }
        }

        stage('Step 05 — Yarn Install') {
            steps {
                dir('cal.diy') {
                    powershell 'yarn install'
                }
            }
        }

        stage('Step 06 — Environment Setup') {
            steps {
                dir('cal.diy') {
                    powershell '''
                        Copy-Item .env.example .env -Force
                        $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
                        $b32 = New-Object byte[] 32; $rng.GetBytes($b32); $NEXTAUTH_SECRET = [Convert]::ToBase64String($b32)
                        $b24 = New-Object byte[] 24; $rng.GetBytes($b24); $CALENDSO_ENCRYPTION_KEY = [Convert]::ToBase64String($b24)
                        (Get-Content .env) | ForEach-Object {
                            if     ($_ -match '^NEXTAUTH_SECRET=')         { "NEXTAUTH_SECRET=$NEXTAUTH_SECRET" }
                            elseif ($_ -match '^CALENDSO_ENCRYPTION_KEY=') { "CALENDSO_ENCRYPTION_KEY=$CALENDSO_ENCRYPTION_KEY" }
                            else                                           { $_ }
                        } | Set-Content .env -Encoding UTF8
                        Add-Content .env "DATABASE_URL=$env:DATABASE_URL"
                        Add-Content .env "DATABASE_DIRECT_URL=$env:DATABASE_DIRECT_URL"
                        Copy-Item .env packages/prisma/.env -Force
                    '''
                }
            }
        }

        stage('Step 07 — Lint') {
            steps {
                dir('cal.diy') {
                    powershell 'yarn lint'
                }
            }
        }

        stage('Step 08 — Type Check') {
            environment {
                NODE_OPTIONS = '--max-old-space-size=6144'
            }
            steps {
                dir('cal.diy') {
                    powershell 'yarn turbo run type-check --env-mode=loose'
                }
            }
        }

        stage('Step 10 — Prisma Validate') {
            steps {
                dir('cal.diy') {
                    powershell 'yarn workspace @calcom/prisma prisma validate'
                }
            }
        }

        stage('Step 11 — Start Database') {
            steps {
                dir('cal.diy') {
                    powershell '''
                        $ErrorActionPreference = 'Continue'
                        docker compose -f packages/prisma/docker-compose.yml up -d
                        if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
                        Start-Sleep -Seconds 5
                    '''
                }
            }
        }

        stage('Step 12 — Build') {
            environment {
                NODE_OPTIONS = '--max-old-space-size=6144'
            }
            steps {
                dir('cal.diy') {
                    powershell 'yarn turbo run build --env-mode=loose --filter=!@calcom/base'
                }
            }
        }

        stage('Step 13 — Stop Database') {
            // Mirrors `if: always()` from the GH workflow.
            // Declarative pipelines don't allow per-stage post-conditions to
            // bypass earlier failures by default, so we run this in `post.always`
            // of the parent pipeline as well (see below). Here we still run it
            // when the previous stages succeeded.
            steps {
                dir('cal.diy') {
                    powershell '''
                        $ErrorActionPreference = 'Continue'
                        docker compose -f packages/prisma/docker-compose.yml down
                        $global:LASTEXITCODE = 0
                    '''
                }
            }
        }

        stage('Step 14 — Docker Build') {
            steps {
                dir('cal.diy') {
                    powershell '''
                        $ErrorActionPreference = 'Continue'
                        Get-ChildItem -Path . -Recurse -Include *.sh -File |
                          Where-Object { $_.FullName -notmatch '\\node_modules\\' } |
                          ForEach-Object {
                            $bytes = [IO.File]::ReadAllBytes($_.FullName)
                            if ($bytes -contains 13) {
                              $text = [Text.Encoding]::UTF8.GetString($bytes) -replace "`r`n", "`n" -replace "`r", "`n"
                              [IO.File]::WriteAllBytes($_.FullName, [Text.Encoding]::UTF8.GetBytes($text))
                              Write-Host "Normalized LF: $($_.FullName)"
                            }
                          }
                        docker build -t cal-diy:bench -f Dockerfile .
                        $buildExit = $LASTEXITCODE
                        if ($buildExit -eq 0) { docker rmi -f cal-diy:bench | Out-Null }
                        $global:LASTEXITCODE = 0
                        if ($buildExit -ne 0) { exit $buildExit }
                    '''
                }
            }
        }
    }

    post {
        always {
            // Best-effort DB teardown to mirror `if: always()` on Step 13,
            // in case an earlier stage failed before reaching it.
            dir('cal.diy') {
                powershell '''
                    $ErrorActionPreference = 'Continue'
                    if (Test-Path packages/prisma/docker-compose.yml) {
                        docker compose -f packages/prisma/docker-compose.yml down 2>$null | Out-Null
                    }
                    $global:LASTEXITCODE = 0
                '''
            }
        }
    }
}
