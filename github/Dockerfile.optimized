FROM php:8.1-cli

ARG RUNNER_VERSION="2.327.1"
ARG DEBIAN_FRONTEND=noninteractive

# Install system dependencies and PHP extensions in optimized layers
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    git \
    sudo \
    ca-certificates \
    unzip \
    zip \
    libzip-dev \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libpq-dev \
    libicu-dev \
    gnupg \
    lsb-release && \
    # Install PHP extensions using docker-php-ext-install (much faster)
    docker-php-ext-install -j$(nproc) \
    pdo_mysql \
    pdo_pgsql \
    pgsql \
    zip \
    gd \
    mbstring \
    xml \
    bcmath \
    intl && \
    # Install sqlite3 extension
    apt-get install -y --no-install-recommends libsqlite3-dev && \
    docker-php-ext-install pdo_sqlite && \
    # Clean up
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    # Create runner user
    useradd -m runner && \
    echo "runner ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Install Composer
COPY --from=composer:2.7 /usr/bin/composer /usr/local/bin/composer

# Install Node.js 18.x and npm
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Docker CLI
RUN install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null && \
    apt-get update && \
    apt-get install -y --no-install-recommends docker-ce-cli && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install cAdvisor
RUN curl -L https://github.com/google/cadvisor/releases/download/v0.47.0/cadvisor-v0.47.0-linux-amd64 -o /usr/local/bin/cadvisor && \
    chmod +x /usr/local/bin/cadvisor

WORKDIR /home/runner

# Install GitHub Actions Runner
RUN curl -o actions-runner-linux-arm64-2.327.1.tar.gz -L https://github.com/actions/runner/releases/download/v2.327.1/actions-runner-linux-arm64-2.327.1.tar.gz && \
    echo "16102096988246f250a745c6a813a5a0b8901e2f554f9440c97e8573fd4da111  actions-runner-linux-arm64-2.327.1.tar.gz" | shasum -a 256 -c && \
    tar xzf actions-runner-linux-arm64-2.327.1.tar.gz && \
    rm actions-runner-linux-arm64-2.327.1.tar.gz

RUN chown -R runner:runner /home/runner

COPY start.sh /home/runner/start.sh
RUN chmod +x /home/runner/start.sh

# Install runner dependencies as root first
RUN ./bin/installdependencies.sh

# Add runner to docker group (if exists)
RUN groupadd -f docker && usermod -aG docker runner

# Switch to runner user
USER runner

ENTRYPOINT ["/home/runner/start.sh"]
