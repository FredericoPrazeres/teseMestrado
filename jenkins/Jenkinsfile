pipeline {
    agent any

    environment {
        // Point this to a Node 22 installation on the Jenkins host.
        NODE_HOME = 'C:\\tools\\node-v22.22.3-win-x64'
        PATH = "${NODE_HOME};${env.PATH}"
        COREPACK_ENABLE_STRICT = '0'
        COREPACK_ENABLE_AUTO_PIN = '0'
    }

    stages {
        stage('Build and Test') {
            steps {
                checkout scm
                bat 'git submodule update --init --recursive'
                dir('directus') {
                    bat 'node -v && npm -v'
                    bat 'node -v | findstr /b "v22." >nul || (echo Node 22 is required. Current version: & node -v & exit /b 1)'
                    bat 'npm install -g pnpm@10 --force'
                    bat 'set "PATH=%APPDATA%\\npm;%PATH%" && pnpm install --frozen-lockfile'
                    bat 'set "PATH=%APPDATA%\\npm;%PATH%" && pnpm lint'
                    bat 'set "PATH=%APPDATA%\\npm;%PATH%" && pnpm build'
                }
            }
        }
    }
}

