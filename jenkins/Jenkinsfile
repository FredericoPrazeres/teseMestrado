pipeline {
    agent any

 environment {
        NODE_HOME = '/Users/fredericoprazeres/.nvm/versions/node/v22.22.3'
        PATH = "${NODE_HOME}/bin:${env.PATH}"
        COREPACK_ENABLE_STRICT = '0'
        COREPACK_ENABLE_AUTO_PIN = '0'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git submodule update --init --recursive'
            }
        }

        stage('Clean dependencies') {
            steps {
                dir('directus') {
                    sh 'rm -rf node_modules'
                }
            }
        }

        stage('Npm install') {
            steps {
                sh 'npm install -g pnpm@10 --force'
            }
        }

        stage('Npm list') {
            steps {
                sh 'npm list -g pnpm'
            }
        }

        stage('Install pnpm') {
            steps {
                dir('directus') {
                    sh 'pnpm install --frozen-lockfile'
                }
            }
        }

        stage('Lint') {
            steps {
                dir('directus') {
                    sh 'pnpm lint'
                }
            }
        }

        stage('Build') {
            steps {
                dir('directus') {
                    sh 'pnpm build'
                }
            }
        }
    }
}



